# Build artifacts
*.exe
*.scr
*.dll
*.log
*.test
*.prof
/out/
/bin/

# Extension-less binaries produced by `make fxshot` / `make wfetch` / `make setshot` on Linux.
/fxshot
/wfetch
/setshot

# The installer payload placeholder is tracked (see the note at the bottom of this
# file), so it must survive the *.scr rule above.
!cmd/setup/payload/WeatherScr.scr

# Runtime files written next to the .scr
scr.log
scr.debug
scr.layers
scr.fps
scr.cls
weather-cache.json
config.json

# Local previews and scratch renders
*.tmp.png
/preview/

# Editor
.idea/
.vscode/
*.swp
.DS_Store

# The installer payload is tracked as a placeholder so a fresh clone compiles.
# `make payload` overwrites it with a real binary. Never commit that change.
# The line below is deliberately commented out: git does not ignore tracked files,
# and listing it here would only suggest that committing the binary is expected.
# cmd/setup/payload/WeatherScr.scr
